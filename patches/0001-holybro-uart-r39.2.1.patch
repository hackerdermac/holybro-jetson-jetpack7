--- a/hardware/nvidia/t23x/nv-public/nv-platform/tegra234-p3768-0000+p3767-xxxx-nv-common.dtsi
+++ b/hardware/nvidia/t23x/nv-public/nv-platform/tegra234-p3768-0000+p3767-xxxx-nv-common.dtsi
@@ -13,6 +13,8 @@
 	aliases {
 		serial1 = &uarta;
 		serial2 = &uarte;
+		/* Holybro Pixhawk Jetson baseboard: UARTB as ttyTHS3 */
+		serial3 = "/bus@0/serial@3110000";
 	};
 
 	bpmp {
@@ -39,6 +41,21 @@
 			status = "okay";
 		};
 
+		/*
+		 * Holybro: enable UARTB (ttyTHS3); pins are already muxed to uartb by the stock MB1 pinmux.
+		 * Unlike Holybro's JetPack 6.2.2 patch, UARTA (ttyTHS1, Pixhawk TELEM2) keeps NVIDIA's GPC-DMA
+		 * and UARTB uses it too (request 9 in the Tegra234 UART numbering: UARTA 8, UARTB 9, ...,
+		 * UARTE 20). See docs/uxrce-dds-benchmark.md for why.
+		 */
+		uartb: serial@3110000 {
+			compatible = "nvidia,tegra194-hsuart";
+			reset-names = "serial";
+			iommus = <&smmu_niso0 TEGRA234_SID_GPCDMA>;
+			dmas = <&gpcdma 9>, <&gpcdma 9>;
+			dma-names = "rx", "tx";
+			status = "okay";
+		};
+
 		i2c@3180000 {
 			status = "okay";
 		};
